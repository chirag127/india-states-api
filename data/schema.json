{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/india-states/data/schema.json",
  "title": "India States and Union Territories",
  "description": "All 28 states and 8 union territories with ISO codes, capitals, population, area, and districts count",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier"
      },
      "name": {
        "type": "string",
        "description": "Display name"
      }
    }
  }
}
